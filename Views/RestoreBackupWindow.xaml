<Window x:Class="HansoInputTool.Views.RestoreBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HansoInputTool.Converters"
        Title="バックアップから復元" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">

    <Window.Resources>
        <converters:BoolToManualConverter x:Key="BoolToManualConverter"/>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Input.xlsx のバックアップ -->
            <TextBlock Grid.Row="0" Text="Input.xlsx のバックアップ" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
            <DataGrid Grid.Row="1" ItemsSource="{Binding InputBackups}" SelectedItem="{Binding SelectedInputBackup}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                      Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="2*"/>
                    <DataGridTextColumn Header="作成日時" Binding="{Binding DisplayTime}" Width="160"/>
                    <DataGridTextColumn Header="種類" Binding="{Binding IsManual, Converter={StaticResource BoolToManualConverter}}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Template.xlsx のバックアップ -->
            <TextBlock Grid.Row="2" Text="Template.xlsx のバックアップ" FontWeight="Bold" FontSize="14" Margin="0,20,0,10"/>
            <DataGrid Grid.Row="3" ItemsSource="{Binding TemplateBackups}" SelectedItem="{Binding SelectedTemplateBackup}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                      Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="2*"/>
                    <DataGridTextColumn Header="作成日時" Binding="{Binding DisplayTime}" Width="160"/>
                    <DataGridTextColumn Header="種類" Binding="{Binding IsManual, Converter={StaticResource BoolToManualConverter}}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ボタン -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="バックアップフォルダを開く" Command="{Binding OpenBackupFolderCommand}" 
                        Background="{StaticResource ButtonSecondaryBgBrush}" Style="{StaticResource NormalButton}" 
                        Margin="0,0,10,0" Height="30" Padding="15,0"/>
                <Button Content="キャンセル" Command="{Binding CancelCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Background="{StaticResource ButtonSecondaryBgBrush}" Style="{StaticResource NormalButton}" 
                        Margin="0,0,10,0" Height="30" Padding="15,0"/>
                <Button Content="復元" Command="{Binding RestoreCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Background="{StaticResource GreenBrush}" Style="{StaticResource NormalButton}"
                        Height="30" Padding="15,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>