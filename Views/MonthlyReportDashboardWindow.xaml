<Window x:Class="HansoInputTool.Views.MonthlyReportDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HansoInputTool.Converters"
        xmlns:vm="clr-namespace:HansoInputTool.ViewModels"
        Title="月報統計ダッシュボード" 
        Height="950" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="#0A0E27"
        FontFamily="Yu Gothic UI, Meiryo UI">
    
    <Window.Resources>
        <!-- コンバーター -->
        <local:TotalKmConverter x:Key="TotalKmConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- カラーパレット -->
        <SolidColorBrush x:Key="PrimaryDark" Color="#0A0E27"/>
        <SolidColorBrush x:Key="SecondaryDark" Color="#1A1F3A"/>
        <SolidColorBrush x:Key="CardBackground" Color="#141829"/>
        <SolidColorBrush x:Key="AccentGold" Color="#F4B942"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2D3548"/>
        
        <!-- 統計カードスタイル -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="20" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- カードタイトル -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <!-- 大きな数値 -->
        <Style x:Key="BigNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        
        <!-- 単位 -->
        <Style x:Key="UnitText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        
        <!-- モダンボタン -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- ゴールドボタン -->
        <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentGold}"/>
            <Setter Property="Foreground" Value="#0A0E27"/>
        </Style>
        
        <!-- ComboBoxスタイル -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <!-- ToggleButtonスタイル -->
        <Style x:Key="ToggleViewButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">
                <!-- ヘッダー -->
                <Grid Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding DisplayTitle}" 
                                   FontSize="36" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="月報ファイルから統計を表示" 
                                   FontSize="14" 
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" 
                            Content="📁 フォルダ選択" 
                            Style="{StaticResource ModernButton}"
                            Command="{Binding SelectFolderCommand}"
                            Margin="0,0,12,0"/>
                    
                    <Button Grid.Column="2" 
                            Content="📊 レポート出力" 
                            Style="{StaticResource GoldButton}"
                            Command="{Binding ExportReportCommand}"/>
                </Grid>
                
                <!-- フォルダパス表示 -->
                <Border Style="{StaticResource StatCard}" 
                        Margin="0,0,0,24"
                        Visibility="{Binding HasReports, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="データソース" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding RootFolderPath}" 
                                   FontSize="14" 
                                   Foreground="{StaticResource AccentBlue}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                
                <!-- 年度・月選択とビュー切替 -->
                <Grid Margin="0,0,0,24" 
                      Visibility="{Binding HasReports, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,24,0">
                        <TextBlock Text="年度:" 
                                   VerticalAlignment="Center" 
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AvailableYears}"
                                  SelectedItem="{Binding SelectedYear}"
                                  Style="{StaticResource ModernComboBox}"
                                  Width="120"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,0"
                                Visibility="{Binding ShowMonthly, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="月:" 
                                   VerticalAlignment="Center" 
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AvailableMonths}"
                                  SelectedItem="{Binding SelectedMonth}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource ModernComboBox}"
                                  Width="180"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <RadioButton Content="月別" 
                                     Command="{Binding ShowMonthlyCommand}"
                                     IsChecked="{Binding ShowMonthly, Mode=OneWay}"
                                     Style="{StaticResource ToggleViewButton}"
                                     Margin="0,0,8,0"/>
                        <RadioButton Content="年間" 
                                     Command="{Binding ShowYearlyCommand}"
                                     IsChecked="{Binding ShowYearly, Mode=OneWay}"
                                     Style="{StaticResource ToggleViewButton}"/>
                    </StackPanel>
                </Grid>
                
                <!-- ローディング表示 -->
                <Border Style="{StaticResource StatCard}"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,0,0,24">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="データを読み込み中..." 
                                   FontSize="18" 
                                   Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- エラー表示 -->
                <Border Style="{StaticResource StatCard}"
                        Background="#2D1F1F"
                        BorderBrush="{StaticResource AccentRed}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="⚠ エラー" 
                                   Style="{StaticResource CardTitle}"
                                   Foreground="{StaticResource AccentRed}"/>
                        <TextBlock Text="{Binding ErrorMessage}" 
                                   FontSize="14" 
                                   Foreground="{StaticResource TextPrimary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                
                <!-- メイン統計カード -->
                <Grid Visibility="{Binding HasData, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 搬送回数 -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="搬送回数" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding CurrentStatistics.TotalHanso, StringFormat=N0}" 
                                           Style="{StaticResource BigNumber}"/>
                                <TextBlock Text="回" Style="{StaticResource UnitText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- 推定売上 -->
                    <Border Grid.Column="1" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="推定売上" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="¥" 
                                           FontSize="28" 
                                           Foreground="{StaticResource AccentGreen}"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,4,8"/>
                                <TextBlock Text="{Binding CurrentStatistics.EstimatedRevenue, StringFormat=N0}" 
                                           Style="{StaticResource BigNumber}"
                                           Foreground="{StaticResource AccentGreen}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- 総走行距離 -->
                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="総走行距離" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding CurrentStatistics, Converter={StaticResource TotalKmConverter}, StringFormat=N1}" 
                                           Style="{StaticResource BigNumber}"
                                           Foreground="{StaticResource AccentBlue}"/>
                                <TextBlock Text="km" Style="{StaticResource UnitText}"/>
                            </StackPanel>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="有料" 
                                               FontSize="12" 
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding CurrentStatistics.TotalYuryoKm, StringFormat=N1}" 
                                               FontSize="18" 
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="無料" 
                                               FontSize="12" 
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding CurrentStatistics.TotalMuryoKm, StringFormat=N1}" 
                                               FontSize="18" 
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- 車両数 -->
                    <Border Grid.Column="3" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="稼働車両数" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding CurrentStatistics.ActiveVehicleCount}" 
                                           Style="{StaticResource BigNumber}"
                                           Foreground="{StaticResource AccentGold}"/>
                                <TextBlock Text="台" Style="{StaticResource UnitText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- セカンダリ統計 -->
                <Grid Margin="0,16,0,0" 
                      Visibility="{Binding HasData, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 営業統計 -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="営業統計" Style="{StaticResource CardTitle}"/>
                            <StackPanel Margin="0,8,0,0">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               Text="営業日数:" 
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="14"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding CurrentStatistics.WorkingDays, StringFormat={}  {0} 日}" 
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               Text="1日平均:" 
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="14"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding CurrentStatistics.AverageHansoPerDay, StringFormat={}  {0:N1} 回}" 
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- 特殊料金 -->
                    <Border Grid.Column="1" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="特殊料金" Style="{StaticResource CardTitle}"/>
                            <StackPanel Margin="0,8,0,0">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               Text="深夜料金:" 
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="14"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding CurrentStatistics.TotalLateCharges, StringFormat={}  ¥{0:N0}}" 
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               Text="行旅回数:" 
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="14"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding CurrentStatistics.TotalKoryo, StringFormat={}  {0} 回}" 
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- 平均値 -->
                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="1回あたり平均" Style="{StaticResource CardTitle}"/>
                            <StackPanel Margin="0,8,0,0">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               Text="有料キロ:" 
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="14"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding CurrentStatistics.AverageYuryoKm, StringFormat={}  {0:N1} km}" 
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               Text="無料キロ:" 
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="14"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding CurrentStatistics.AverageMuryoKm, StringFormat={}  {0:N1} km}" 
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               Text="売上:" 
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="14"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding CurrentStatistics.AverageRevenuePerTrip, StringFormat={}  ¥{0:N0}}" 
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- 記録 -->
                <Grid Margin="0,16,0,0" 
                      Visibility="{Binding HasData, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="最大搬送記録" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding CurrentStatistics.MaxDailyHanso}" 
                                           FontSize="36" 
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentGold}"/>
                                <TextBlock Text="回" 
                                           FontSize="16" 
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Bottom"
                                           Margin="4,0,0,4"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentStatistics.MaxDailyHansoDate, StringFormat={}({0:M月d日})}" 
                                       FontSize="14" 
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="1" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="最大走行記録" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding CurrentStatistics.MaxDailyKm, StringFormat=N1}" 
                                           FontSize="36" 
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBlue}"/>
                                <TextBlock Text="km" 
                                           FontSize="16" 
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Bottom"
                                           Margin="4,0,0,4"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentStatistics.MaxDailyKmDate, StringFormat={}({0:M月d日})}" 
                                       FontSize="14" 
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
