<Window x:Class="HansoInputTool.Views.VehicleAnnualSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HansoInputTool.ViewModels"
        Title="年度集計"
        Width="900" Height="720"
        MinWidth="780" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

    <Window.DataContext>
        <vm:VehicleAnnualSummaryViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#111C2F"/>
            <Setter Property="BorderBrush" Value="#263B5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="Background" Value="#172033"/>
            <Setter Property="BorderBrush" Value="#2B4A7A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style x:Key="VehicleLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="年度集計" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="運輸実績を車両別に集計し、Excelへ出力します。"
                           Style="{StaticResource SectionCaption}" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Period / folder -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="① 集計対象フォルダ" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="月報ファイルが入っている最上位フォルダを指定してください。"
                               Style="{StaticResource SectionCaption}" Margin="0,4,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource FieldBox}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding FolderPath}"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"
                                       Padding="10,8"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding FolderPath}"/>
                        </Border>
                        <Button Grid.Column="1" Content="フォルダを選択"
                                Width="110" Height="34"
                                Style="{StaticResource NormalButton}"
                                Command="{Binding SelectFolderCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="② 集計期間" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="開始月から終了月までを指定します。"
                               Style="{StaticResource SectionCaption}" Margin="0,4,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource FieldBox}" Padding="8,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding StartYear, UpdateSourceTrigger=PropertyChanged}"
                                         Width="58" Height="30" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" IsEnabled="{Binding IsNotBusy}"/>
                                <TextBlock Text="年" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="4,0,7,0"/>
                                <TextBox Text="{Binding StartMonth, UpdateSourceTrigger=PropertyChanged}"
                                         Width="35" Height="30" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" IsEnabled="{Binding IsNotBusy}"/>
                                <TextBlock Text="月" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Column="1" Text="～" Foreground="{StaticResource SubTextBrush}"
                                   FontSize="16" VerticalAlignment="Center" Margin="8,0"/>

                        <Border Grid.Column="2" Style="{StaticResource FieldBox}" Padding="8,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding EndYear, UpdateSourceTrigger=PropertyChanged}"
                                         Width="58" Height="30" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" IsEnabled="{Binding IsNotBusy}"/>
                                <TextBlock Text="年" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="4,0,7,0"/>
                                <TextBox Text="{Binding EndMonth, UpdateSourceTrigger=PropertyChanged}"
                                         Width="35" Height="30" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" IsEnabled="{Binding IsNotBusy}"/>
                                <TextBlock Text="月" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Vehicle area -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="③ 集計対象車両" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="集計する車両にチェックを入れてください。未分類車両はオレンジ色で表示されます。"
                                   Style="{StaticResource SectionCaption}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="全選択" Width="76" Height="30"
                            Style="{StaticResource NormalButton}"
                            Command="{Binding SelectAllCommand}" Margin="0,0,6,0"/>
                    <Button Grid.Column="2" Content="全解除" Width="76" Height="30"
                            Background="{StaticResource ButtonSecondaryBgBrush}"
                            Style="{StaticResource NormalButton}"
                            Command="{Binding DeselectAllCommand}"/>
                </Grid>

                <Button Grid.Row="1" Content="車両を読み込む"
                        Height="36" Margin="0,14,0,12"
                        FontSize="13" FontWeight="SemiBold"
                        Style="{StaticResource NormalButton}"
                        Command="{Binding ScanVehiclesCommand}"/>

                <Border Grid.Row="2" Background="#0B1426" BorderBrush="#263B5C" BorderThickness="1" CornerRadius="5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Vehicles}" Margin="10,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111C2F" BorderBrush="#1E3150" BorderThickness="1"
                                            CornerRadius="4" Margin="0,0,0,6" Padding="8,7">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                            <CheckBox.Content>
                                                <TextBlock Text="{Binding Label}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource VehicleLabelStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsKnown}" Value="False">
                                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </CheckBox.Content>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Selection summary -->
        <Border Grid.Row="3" Background="#0F1A2D" BorderBrush="#263B5C" BorderThickness="1"
                CornerRadius="5" Padding="14,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="集計対象：" Foreground="{StaticResource SubTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedVehicleCount}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="台" Foreground="{StaticResource SubTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="2,0,22,0"/>
                    <TextBlock Text="期間：" Foreground="{StaticResource SubTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StartYear}" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="/" Foreground="{StaticResource SubTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="2,0"/>
                    <TextBlock Text="{Binding StartMonth, StringFormat={}{0:D2}}" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text=" ～ " Foreground="{StaticResource SubTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding EndYear}" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="/" Foreground="{StaticResource SubTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="2,0"/>
                    <TextBlock Text="{Binding EndMonth, StringFormat={}{0:D2}}" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding VehicleCount, StringFormat=車両検出：{0}台}"
                           Foreground="{StaticResource SubTextBrush}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0F1A2D" BorderBrush="#263B5C" BorderThickness="1"
                    CornerRadius="5" Padding="12,9" Margin="0,0,12,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SubTextBrush}"
                           FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Border>

            <Button Grid.Column="1" Content="Excelへ出力"
                    Width="150" Height="44"
                    FontSize="14" FontWeight="SemiBold"
                    Background="{StaticResource GreenBrush}"
                    Style="{StaticResource NormalButton}"
                    Command="{Binding ExecuteCommand}"/>
        </Grid>
    </Grid>
</Window>
