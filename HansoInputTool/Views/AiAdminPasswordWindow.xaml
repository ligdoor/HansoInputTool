<Window x:Class="HansoInputTool.Views.AiAdminPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI設定の認証"
        Height="300" Width="460"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🔒 AI設定管理パスワード" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="1" Text="プロバイダー・モデル・APIキーの変更や表示には認証が必要です。"
                   Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="2" Text="パスワード" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="3" Height="34" Padding="8,6"
                     Background="#172033" Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource InputBorderBrush}"/>
        <TextBlock x:Name="ConfirmLabel" Grid.Row="4" Text="パスワード（確認）" Foreground="{StaticResource SubTextBrush}" Margin="0,10,0,4"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="5" Height="34" Padding="8,6" VerticalAlignment="Top"
                     Background="#172033" Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource InputBorderBrush}"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="キャンセル" Click="CancelButton_Click" Style="{StaticResource NormalButton}"
                    Background="{StaticResource ButtonSecondaryBgBrush}" Padding="16,7" Margin="0,0,8,0"/>
            <Button Content="認証" Click="OkButton_Click" Style="{StaticResource NormalButton}"
                    Background="{StaticResource AccentBrush}" Padding="16,7"/>
        </StackPanel>
    </Grid>
</Window>
