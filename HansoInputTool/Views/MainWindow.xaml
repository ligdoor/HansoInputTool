<Window x:Class="HansoInputTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:converters="clr-namespace:HansoInputTool.Converters"
        mc:Ignorable="d"
        Title="搬送実績入力ツール"
        Height="820" Width="1034"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <Style x:Key="PlaceholderTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- この画面のタブは必ず既存のダーク配色で描画する -->
        <Style x:Key="DarkTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Background" Value="{StaticResource InactiveTabBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="Padding" Value="28,9"/>
        </Style>

        <!-- 参照デザイン用：既存のダーク配色をそのまま使い、枠線と余白だけ整える -->
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource NormalButton}">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryToolbarButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>

        <Style x:Key="ReportToolbarButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputHoverBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="SaveToolbarButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#062c2a"/>
            <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
            <Setter Property="Width" Value="132"/>
        </Style>

        <Style x:Key="TransferToolbarButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#332218"/>
            <Setter Property="BorderBrush" Value="#f97316"/>
            <Setter Property="Foreground" Value="#fb923c"/>
            <Setter Property="Width" Value="132"/>
        </Style>

        <Style x:Key="EditGridButton" TargetType="Button" BasedOn="{StaticResource NormalButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputHoverBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#102b4d"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style x:Key="NormalInputPanelStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="1">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EastInputPanelStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="1">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ContextMenu は既定テーマだと白くなるため、ここで明示的にダーク化 -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding OnLoadedCommand}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding OnClosingCommand}" PassEventArgsToCommand="True"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Background="{StaticResource BgBrush}">
        <Grid Margin="22,12,22,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="搬送実績入力ツール" FontSize="27" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding AppVersion}" FontSize="17" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Bottom" Margin="14,0,0,3"/>
                </StackPanel>
                <TextBlock Text="搬送実績の入力・集計・転記をサポート"
                           Foreground="{StaticResource SubTextBrush}" FontSize="13"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- TOOLBAR：期/R/月 → 入力 → 月報読込 → 集計 / 右端に保存・転記 -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border BorderBrush="{StaticResource InputHoverBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,0,7,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="期：" Foreground="{StaticResource SubTextBrush}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBox x:Name="PeriodTextBox" Text="{Binding Period, UpdateSourceTrigger=PropertyChanged}"
                                     Width="42" FontSize="16" HorizontalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0" Padding="2"
                                     KeyDown="TextBox_KeyDown" TabIndex="1"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{StaticResource InputHoverBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,0,7,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding EraName}" Foreground="{StaticResource SubTextBrush}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="：" Foreground="{StaticResource SubTextBrush}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBox x:Name="RNumberTextBox" Text="{Binding RNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Width="38" FontSize="16" HorizontalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0" Padding="2"
                                     KeyDown="TextBox_KeyDown" TabIndex="2"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{StaticResource InputHoverBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="月：" Foreground="{StaticResource SubTextBrush}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBox x:Name="MonthTextBox" Text="{Binding Month, UpdateSourceTrigger=PropertyChanged}"
                                     Width="38" FontSize="16" HorizontalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0" Padding="2"
                                     KeyDown="TextBox_KeyDown" TabIndex="3"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 現在位置を示すだけのアクティブ表示。既存機能には触れない -->
                    <Button Command="{Binding LoadGeppoFileCommand}" Style="{StaticResource PrimaryToolbarButton}" Width="212"
                            ToolTip="実績月報を読み込む" RenderTransformOrigin="0.5,0.5" Click="Button_Click_1">
                        <Button.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform AngleX="0"/>
                                <RotateTransform/>
                                <TranslateTransform X="0"/>
                            </TransformGroup>
                        </Button.RenderTransform>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="▣" FontSize="21" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="実績月報を読み込む" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SaveInputCommand}" Style="{StaticResource SaveToolbarButton}" Margin="0,0,10,0"
                            ToolTip="現在の入力内容を保存（Ctrl+S）">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="▣" FontSize="22" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="保存" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding TransferCommand}" Style="{StaticResource TransferToolbarButton}"
                            ToolTip="転記処理を開始（Ctrl+T）">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⇄" FontSize="24" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="転記" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- MAIN -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" MinWidth="370" MaxWidth="430"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: vehicle + input -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 車両選択：現在の車両名はComboBoxだけで表示し、重複表示しない -->
                    <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex}" Margin="0,0,0,8" Background="Transparent">
                        <TabItem Header="通常" Style="{StaticResource DarkTabItemStyle}" FontSize="15" FontWeight="SemiBold">
                            <StackPanel Margin="12,8,12,8" DataContext="{Binding NormalSheet}">
                                <TextBlock Text="車両選択" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding NormalSheets}" SelectedItem="{Binding SelectedNormalSheet}"
                                          TabIndex="4" Height="36" FontSize="14"/>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="東日本" Style="{StaticResource DarkTabItemStyle}" FontSize="15" FontWeight="SemiBold">
                            <StackPanel Margin="12,8,12,8" DataContext="{Binding EastSheet}">
                                <TextBlock Text="車両選択" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding EastSheets}" SelectedItem="{Binding SelectedEastSheet}"
                                          TabIndex="10" Height="36" FontSize="14"/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <!-- 通常シート：通常時はスクロールなしで1件登録まで完結する -->
                    <Border Grid.Row="1" Style="{StaticResource NormalInputPanelStyle}" Padding="12" DataContext="{Binding NormalSheet}">
                        <StackPanel>
                            <TextBlock Text="実績入力" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <!-- 日 / 有料km、無料km / 深夜時間（または深夜料金） -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,7">
                                    <TextBlock Text="日" FontSize="13" Margin="0,0,0,2"/>
                                    <TextBox x:Name="NormalDayTextBox" Text="{Binding Day, UpdateSourceTrigger=PropertyChanged}"
                                             Height="32" FontSize="15" HorizontalContentAlignment="Left"
                                             KeyDown="TextBox_KeyDown" TabIndex="5"/>
                                    <TextBlock Text="{Binding DayError}" Style="{StaticResource ErrorTextStyle}"
                                               Visibility="{Binding DayError, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,7">
                                    <TextBlock Text="有料km" FontSize="13" Margin="0,0,0,2"/>
                                    <TextBox x:Name="NormalYuryoKmTextBox" Text="{Binding YuryoKm, UpdateSourceTrigger=PropertyChanged}"
                                             Height="32" FontSize="15" HorizontalContentAlignment="Left"
                                             KeyDown="TextBox_KeyDown" TabIndex="6"/>
                                    <TextBlock Text="{Binding YuryoKmError}" Style="{StaticResource ErrorTextStyle}"
                                               Visibility="{Binding YuryoKmError, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="無料km" FontSize="13" Margin="0,0,0,2"/>
                                    <TextBox x:Name="NormalMuryoKmTextBox" Text="{Binding MuryoKm, UpdateSourceTrigger=PropertyChanged}"
                                             Height="32" FontSize="15" HorizontalContentAlignment="Left"
                                             KeyDown="TextBox_KeyDown" TabIndex="7"/>
                                    <TextBlock Text="{Binding MuryoKmError}" Style="{StaticResource ErrorTextStyle}"
                                               Visibility="{Binding MuryoKmError, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                        <TextBlock Text="{Binding LateInputLabel}" FontSize="13" DockPanel.Dock="Left"/>
                                        <Button Content="🌙 深夜計算" DockPanel.Dock="Right" Padding="6,1" FontSize="11"
                                                Style="{StaticResource NormalButton}" Background="{StaticResource ButtonSecondaryBgBrush}"
                                                ToolTip="会社出発時刻・故人宅出発時刻から深夜時間帯（22:00〜翌5:00）の該当時間・料金を計算します"
                                                Command="{Binding DataContext.OpenLateNightCalculatorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </DockPanel>
                                    <TextBox x:Name="NormalLateValueTextBox" Text="{Binding LateValue, UpdateSourceTrigger=PropertyChanged}"
                                             Height="32" FontSize="15" HorizontalContentAlignment="Left"
                                             KeyDown="LastNormalTextBox_KeyDown" TabIndex="8"/>
                                    <TextBlock Text="{Binding LateValueError}" Style="{StaticResource ErrorTextStyle}"
                                               Visibility="{Binding LateValueError, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 特殊項目：通常のEnter移動から除外。ショートカットは常時表示 -->
                            <Border BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,9,0,0">
                                <StackPanel>
                                    <TextBlock Text="特殊項目（ショートカット）" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding FlagItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="1,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" Content="{Binding DisplayName}" IsChecked="{Binding IsChecked}" IsTabStop="False" FontSize="13"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ShortcutDisplay}" Foreground="{StaticResource SubTextBrush}"
                                                               FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 給油対象車両のみ表示。チェック後も同じカード内で入力し、登録を押し下げすぎない -->
                                    <Border Visibility="{Binding IsFuelTrackedVehicle, Converter={StaticResource BoolToVis}}"
                                            BorderBrush="Transparent" BorderThickness="0" Margin="0,2,0,0" Padding="0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" Content="給油あり" IsChecked="{Binding IsFuelChecked}" IsTabStop="False" FontSize="13"/>
                                                <TextBlock Grid.Column="1" Text="" Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
                                            </Grid>

                                            <Grid Visibility="{Binding IsFuelChecked, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="給油時距離" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding FuelOdometerKm, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" FontSize="14" KeyDown="TextBox_KeyDown" TabIndex="9"/>
                                                    <TextBlock Text="{Binding FuelOdometerKmError}" Style="{StaticResource ErrorTextStyle}"
                                                               Visibility="{Binding FuelOdometerKmError, Converter={StaticResource StringToVisibilityConverter}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="リッター" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding FuelLiters, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" FontSize="14" KeyDown="TextBox_KeyDown" TabIndex="10"/>
                                                    <TextBlock Text="{Binding FuelLitersError}" Style="{StaticResource ErrorTextStyle}"
                                                               Visibility="{Binding FuelLitersError, Converter={StaticResource StringToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Button Command="{Binding RegisterNormalCommand}" Style="{StaticResource PrimaryToolbarButton}"
                                    Height="46" Margin="0,9,0,0" TabIndex="11">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="＋" FontSize="23" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="登録（Enter）" FontSize="16" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 東日本シート：既存項目を維持しつつ、余白だけ圧縮 -->
                    <Border Grid.Row="1" Style="{StaticResource EastInputPanelStyle}" Padding="12" DataContext="{Binding EastSheet}">
                        <StackPanel>
                            <TextBlock Text="実績入力" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,7">
                                    <TextBlock Text="延実働車輌数" FontSize="13" Margin="0,0,0,2"/>
                                    <TextBox x:Name="EastJitsudoTextBox" Text="{Binding Jitsudo, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="15" KeyDown="TextBox_KeyDown" TabIndex="12"/>
                                    <TextBlock Text="{Binding JitsudoError}" Style="{StaticResource ErrorTextStyle}" Visibility="{Binding JitsudoError, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,7">
                                    <TextBlock Text="搬送回数" FontSize="13" Margin="0,0,0,2"/>
                                    <TextBox x:Name="EastHansoTextBox" Text="{Binding Hanso, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="15" KeyDown="TextBox_KeyDown" TabIndex="13"/>
                                    <TextBlock Text="{Binding HansoError}" Style="{StaticResource ErrorTextStyle}" Visibility="{Binding HansoError, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,7">
                                    <TextBlock Text="有料km" FontSize="13" Margin="0,0,0,2"/>
                                    <TextBox x:Name="EastYuryoKmTextBox" Text="{Binding YuryoKm, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="15" KeyDown="TextBox_KeyDown" TabIndex="14"/>
                                    <TextBlock Text="{Binding YuryoKmError}" Style="{StaticResource ErrorTextStyle}" Visibility="{Binding YuryoKmError, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,7">
                                    <TextBlock Text="無料km" FontSize="13" Margin="0,0,0,2"/>
                                    <TextBox x:Name="EastMuryoKmTextBox" Text="{Binding MuryoKm, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="15" KeyDown="TextBox_KeyDown" TabIndex="15"/>
                                    <TextBlock Text="{Binding MuryoKmError}" Style="{StaticResource ErrorTextStyle}" Visibility="{Binding MuryoKmError, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="運輸実績" FontSize="13" Margin="0,0,0,2"/>
                                    <TextBox x:Name="EastUnsoTextBox" Text="{Binding Unso, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="15" KeyDown="LastEastTextBox_KeyDown" TabIndex="16"/>
                                    <TextBlock Text="{Binding UnsoError}" Style="{StaticResource ErrorTextStyle}" Visibility="{Binding UnsoError, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding SheetStatus}" Foreground="{StaticResource SubTextBrush}" Margin="2,6,0,0"/>
                            <Button Command="{Binding RegisterEastCommand}" Style="{StaticResource PrimaryToolbarButton}" Height="46" Margin="0,8,0,0" TabIndex="17">
                                <TextBlock Text="＋ 登録（Enter）" FontSize="16"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- RIGHT: preview -->
                <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="3,0,3,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="▣" FontSize="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="実績一覧" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PreviewData.Count, StringFormat={}  {0}件}" Foreground="{StaticResource SubTextBrush}" FontSize="13" VerticalAlignment="Center" Margin="10,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding EditRowCommand}" Style="{StaticResource EditGridButton}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✎" FontSize="18" Margin="0,0,7,0"/>
                                        <TextBlock Text="編集" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DeleteRowCommand}" Style="{StaticResource EditGridButton}" Background="#35151b" BorderBrush="{StaticResource RedBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▣" FontSize="17" Margin="0,0,7,0"/>
                                        <TextBlock Text="削除" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1" x:Name="PreviewDataGrid"
                                  ItemsSource="{Binding PreviewDataView}"
                                  AutoGenerateColumns="False"
                                  SelectedItem="{Binding SelectedRow}"
                                  PreviewKeyDown="PreviewDataGrid_PreviewKeyDown"
                                  MouseDoubleClick="PreviewDataGrid_MouseDoubleClick"
                                  CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                                  RowHeight="34" ColumnHeaderHeight="40" FontSize="13">
                            <DataGrid.Resources>
                                <converters:BindingProxy x:Key="Proxy" Data="{Binding}"/>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="日" Binding="{Binding B_Day}" Width="48"/>
                                <DataGridTextColumn Header="搬送" Binding="{Binding C_Hanso}" Width="52"/>
                                <DataGridTextColumn Header="有料km" Binding="{Binding D_YuryoKm, StringFormat={}{0:N0}}" Width="*"/>
                                <DataGridTextColumn Header="無料km" Binding="{Binding E_MuryoKm, StringFormat={}{0:N0}}" Width="*"/>
                                <DataGridTextColumn Header="フラグ" Binding="{Binding FlagSummaryText}" Width="1.3*"/>
                                <DataGridTextColumn Header="給油" Binding="{Binding FuelSummaryText}" Width="2*"/>
                                <DataGridTextColumn Header="深夜料金(円)" Binding="{Binding H_LateFeeOotsuki}" Width="1.3*"
                                                    Visibility="{Binding Data.NormalSheet.IsFeeMode, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}"/>
                                <DataGridTextColumn Header="深夜時間(分)" Binding="{Binding K_LateMinutes}" Width="1.3*"
                                                    Visibility="{Binding Data.NormalSheet.IsFeeMode, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Text="行を選択して Enter＝編集　　Delete＝削除　　ダブルクリック＝編集"
                                   Foreground="{StaticResource SubTextBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,8,2,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- FOOTER：ステータス左、その他を右下 -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Padding="12,8" MinHeight="54" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="●" Foreground="{StaticResource GreenBrush}" FontSize="23" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                                 Height="34" VerticalContentAlignment="Center" Padding="4,2"
                                 BorderThickness="0" Background="Transparent" Foreground="{StaticResource SubTextBrush}"
                                 FontSize="11" TextWrapping="NoWrap"/>
                    </Grid>
                </Border>

                <Button x:Name="OtherButton" Grid.Column="1" Content="⚙ その他 ▼"
                        Style="{StaticResource EditGridButton}" Width="150" Height="54"
                        Background="{StaticResource ButtonSecondaryBgBrush}" FontSize="14"
                        Click="OtherButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="月切替" Command="{Binding PlacementTarget.DataContext.SwitchSessionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="PDF読み込み" Command="{Binding PlacementTarget.DataContext.OpenPdfImportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="年度集計" Command="{Binding PlacementTarget.DataContext.OpenVehicleAnnualSummaryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="バックアップ" Command="{Binding PlacementTarget.DataContext.CreateBackupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="復元" Command="{Binding PlacementTarget.DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="フォルダ" Command="{Binding PlacementTarget.DataContext.OpenBackupFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="ヘルプ" Command="{Binding PlacementTarget.DataContext.OpenHelpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="設定" Command="{Binding PlacementTarget.DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="クリア" Command="{Binding PlacementTarget.DataContext.ClearInputDataCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
