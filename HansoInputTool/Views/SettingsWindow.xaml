<Window x:Class="HansoInputTool.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:HansoInputTool.Converters"
        xmlns:behaviors="clr-namespace:HansoInputTool.Behaviors"
        xmlns:controls="clr-namespace:HansoInputTool.Controls"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="設定" Width="700" Height="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        MinWidth="600" MinHeight="500">
    <Window.Resources>
        <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
        
        <!-- ショートカットリスト用のスタイル -->
        <Style x:Key="ShortcutListViewItem" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{StaticResource InputBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InactiveTabBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Background="{StaticResource BgBrush}">
        <DockPanel Margin="15">
            <!-- ボタンエリア -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="キャンセル" 
                        Background="{StaticResource ButtonSecondaryBgBrush}" 
                        Command="{Binding CancelCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                        Style="{StaticResource NormalButton}"
                        Padding="20,8"/>
                <Button Content="保存" 
                        Background="{StaticResource GreenBrush}" 
                        Command="{Binding SaveCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                        Margin="10,0,0,0" 
                        Style="{StaticResource NormalButton}"
                        Padding="20,8"/>
            </StackPanel>

            <TabControl SelectedIndex="{Binding SelectedTabIndex}">
                <!-- 一般設定タブ -->
                <TabItem Header="一般">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel Margin="10">
                            <GroupBox Header="元号設定" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0">
                                <StackPanel Margin="10">
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,10"
                                               Text="元号が変わったときにここを変更してください。ファイル名やExcelセルに反映されます。"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="元号記号：" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                        <TextBox Width="60" Text="{Binding EraName, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="8,0" MaxLength="3" ToolTip="例：R（令和）、S（新元号）"/>
                                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}"
                                                   Text="（例：令和→R、将来の新元号→その頭文字）"/>
                                    </StackPanel>
                                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource SubTextBrush}"
                                               Text="{Binding EraName, StringFormat=現在の設定: {0}　→　ファイル名例: {0}6 アルス搬送・霊柩車　実績月報}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 車両シート管理タブ -->
                <TabItem Header="車両シート管理">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" Margin="0,0,10,0">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Content="追加 (+)" Command="{Binding AddVehicleCommand}" Style="{StaticResource NormalButton}" MinWidth="80"/>
                                <Button Content="削除 (-)" Command="{Binding DeleteVehicleCommand}" Background="{StaticResource RedBrush}" Margin="10,0,0,0" Style="{StaticResource NormalButton}" MinWidth="80"/>
                            </StackPanel>
                            <Label DockPanel.Dock="Top" Content="車両リスト" FontWeight="Bold"/>
                            <ListView ItemsSource="{Binding VehicleSheetList}" 
                                      SelectedItem="{Binding SelectedVehicle}"
                                      Background="{StaticResource PanelBackgroundBrush}"
                                      BorderThickness="1"
                                      BorderBrush="{StaticResource InputBorderBrush}"
                                      DisplayMemberPath="VehicleTypeName"/>
                        </DockPanel>

                        <!-- 右側: 詳細エリア -->
                        <Grid Grid.Column="1">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedVehicle}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding SelectedVehicle}">
                                    <Label Content="車両詳細" FontWeight="Bold"/>
                                    <GroupBox Header="車両情報" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0">
                                        <StackPanel Margin="5">
                                            <Label Content="営業所"/>
                                            <ComboBox ItemsSource="{Binding 事業所カテゴリリスト}" SelectedItem="{Binding Selected事業所カテゴリ}"/>

                                            <Label Content="車種" Margin="0,5,0,0" Visibility="{Binding Is車種Visible, Converter={StaticResource BoolToVis}}"/>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding Is車種Visible, Converter={StaticResource BoolToVis}}">
                                                <RadioButton Content="寝台車" GroupName="ShashuGroup" IsChecked="{Binding Selected車種, Converter={StaticResource StringToBoolConverter}, ConverterParameter=寝台車}"/>
                                                <RadioButton Content="霊柩車" GroupName="ShashuGroup" IsChecked="{Binding Selected車種, Converter={StaticResource StringToBoolConverter}, ConverterParameter=霊柩車}" Margin="10,0,0,0"/>
                                            </StackPanel>

                                            <Label Content="車種名" Margin="0,5,0,0"/>
                                            <TextBox Text="{Binding IndividualName, UpdateSourceTrigger=PropertyChanged}"/>

                                            <Label Content="番号" Margin="0,5,0,0"/>
                                            <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}">
                                                <i:Interaction.Behaviors>
                                                    <behaviors:NumericInputBehavior/>
                                                </i:Interaction.Behaviors>
                                            </TextBox>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- 料金カテゴリ設定タブ -->
                <TabItem Header="料金設定">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Rates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <GroupBox Header="{Binding Key}" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="0,5">
                                            <StackPanel DataContext="{Binding Value}" Margin="10">
                                                <Label Content="基本料金"/>
                                                <TextBox Text="{Binding BaseFee, UpdateSourceTrigger=PropertyChanged}">
                                                    <i:Interaction.Behaviors>
                                                        <behaviors:NumericInputBehavior/>
                                                    </i:Interaction.Behaviors>
                                                </TextBox>
                                                <Label Content="走行料金" Margin="0,5,0,0"/>
                                                <TextBox Text="{Binding MileageFee, UpdateSourceTrigger=PropertyChanged}">
                                                    <i:Interaction.Behaviors>
                                                        <behaviors:NumericInputBehavior/>
                                                    </i:Interaction.Behaviors>
                                                </TextBox>
                                                <Label Content="深夜固定" Margin="0,5,0,0"/>
                                                <TextBox Text="{Binding LateNightFixedFee, UpdateSourceTrigger=PropertyChanged}">
                                                    <i:Interaction.Behaviors>
                                                        <behaviors:NumericInputBehavior/>
                                                    </i:Interaction.Behaviors>
                                                </TextBox>
                                                <Label Content="深夜単価" Margin="0,5,0,0"/>
                                                <TextBox Text="{Binding LateNightUnitFee, UpdateSourceTrigger=PropertyChanged}">
                                                    <i:Interaction.Behaviors>
                                                        <behaviors:NumericInputBehavior/>
                                                    </i:Interaction.Behaviors>
                                                </TextBox>
                                            </StackPanel>
                                        </GroupBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ショートカット設定タブ -->
                <TabItem Header="ショートカット">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ヘッダー説明 -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="キーボードショートカットの設定" 
                       FontWeight="Bold" 
                       FontSize="14"
                       Margin="0,0,0,5"/>
                            <TextBlock Text="各項目のキー欄をクリックして、使用したいキーの組み合わせを押してください。" 
                       Foreground="{StaticResource SubTextBrush}"
                       TextWrapping="Wrap"/>
                            <TextBlock Text="※ Escキーでキャンセル、修飾キー(Ctrl/Alt/Shift)と組み合わせて設定できます。" 
                       Foreground="{StaticResource SubTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- ショートカットリスト -->
                        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding ShortcutSettingsVM.ShortcutItems}"
                  SelectedItem="{Binding ShortcutSettingsVM.SelectedItem}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="40"
                  Background="{StaticResource PanelBackgroundBrush}"
                  BorderBrush="{StaticResource InputBorderBrush}"
                  BorderThickness="1">
                            <DataGrid.Columns>
                                <!-- アクション列 -->
                                <DataGridTextColumn Header="アクション" 
                                    Width="120" 
                                    IsReadOnly="True"
                                    Binding="{Binding DisplayName}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 説明列 -->
                                <DataGridTextColumn Header="説明" 
                                    Width="*" 
                                    IsReadOnly="True"
                                    Binding="{Binding Description}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- ショートカットキー列 -->
                                <DataGridTemplateColumn Header="ショートカットキー" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:ShortcutKeyBox 
                                ShortcutKey="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ShortcutModifiers="{Binding Modifiers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsRecording="{Binding IsRecording, Mode=TwoWay}"
                                Height="32"
                                Margin="4"
                                Background="{StaticResource BgBrush}"
                                Foreground="{StaticResource TextBrush}"
                                BorderBrush="{StaticResource InputBorderBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 操作ボタン -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="選択をクリア" 
                    Command="{Binding ShortcutSettingsVM.ClearShortcutCommand}"
                    Style="{StaticResource NormalButton}"
                    Background="{StaticResource ButtonSecondaryBgBrush}"
                    Padding="15,6"/>
                            <Button Content="デフォルトに戻す" 
                    Command="{Binding ResetShortcutsCommand}"
                    Style="{StaticResource NormalButton}"
                    Background="{StaticResource RedBrush}"
                    Margin="10,0,0,0"
                    Padding="15,6"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <!-- フラグ管理タブ -->
                <TabItem Header="フラグ管理">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{StaticResource SubTextBrush}"
                                   Text="チェックボックスの項目を管理します。順番はドラッグではなく↑↓ボタンで変更できます。"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左: フラグ一覧 + ボタン -->
                            <DockPanel Grid.Column="0">
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                            HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Button Content="↑"  Command="{Binding FlagSettingsVM.MoveUpCommand}"
                                            Style="{StaticResource NormalButton}" Width="36"/>
                                    <Button Content="↓"  Command="{Binding FlagSettingsVM.MoveDownCommand}"
                                            Style="{StaticResource NormalButton}" Width="36" Margin="4,0"/>
                                    <Button Content="追加" Command="{Binding FlagSettingsVM.AddCommand}"
                                            Style="{StaticResource NormalButton}" MinWidth="50"/>
                                    <Button Content="削除" Command="{Binding FlagSettingsVM.DeleteCommand}"
                                            Background="{StaticResource RedBrush}"
                                            Style="{StaticResource NormalButton}" MinWidth="50" Margin="4,0,0,0"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding FlagSettingsVM.FlagItems}"
                                         SelectedItem="{Binding FlagSettingsVM.SelectedItem}"
                                         DisplayMemberPath="DisplayName"
                                         Background="{StaticResource PanelBackgroundBrush}"
                                         BorderBrush="{StaticResource InputBorderBrush}"/>
                            </DockPanel>

                            <!-- 右: 詳細編集（SelectedItemがないときは非表示）-->
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- 未選択時メッセージ -->
                                    <TextBlock Text="左のリストからフラグを選択してください。"
                                               Foreground="{StaticResource SubTextBrush}"
                                               Margin="8,20,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FlagSettingsVM.SelectedItem}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 選択時: 詳細編集フォーム（バインディングはすべて FlagSettingsVM.SelectedItem.xxx）-->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FlagSettingsVM.SelectedItem}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Label Content="表示名" FontWeight="Bold"/>
                                        <TextBox Text="{Binding FlagSettingsVM.SelectedItem.DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,10"/>

                                        <!-- ショートカットキー設定 -->
                                        <Label Content="ショートカットキー" FontWeight="Bold"/>
                                        <controls:ShortcutKeyBox
                                            ShortcutKey="{Binding FlagSettingsVM.SelectedItem.ShortcutKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ShortcutModifiers="{Binding FlagSettingsVM.SelectedItem.ShortcutModifiers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,0,0,4"/>
                                        <TextBlock Foreground="{StaticResource SubTextBrush}"
                                                   Text="{Binding FlagSettingsVM.SelectedItem.ShortcutDisplayString}"
                                                   Margin="0,0,0,10"/>

                                        <Label Content="種類" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <RadioButton Content="回数のみ（チェックの有無のみ記録）"
                                                         IsChecked="{Binding FlagSettingsVM.SelectedItem.IsTypeCountOnly}"
                                                         GroupName="FlagTypeGroup" Margin="0,0,15,0"/>
                                            <RadioButton Content="金額あり"
                                                         IsChecked="{Binding FlagSettingsVM.SelectedItem.IsTypeWithAmount}"
                                                         GroupName="FlagTypeGroup"/>
                                        </StackPanel>

                                        <!-- 金額ありのみ表示 -->
                                        <StackPanel Visibility="{Binding FlagSettingsVM.SelectedItem.IsWithAmount,
                                                                          Converter={StaticResource BoolToVis}}">
                                            <Label Content="金額タイプ" FontWeight="Bold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <RadioButton Content="倍率（例: 0.5 = 基本料金の半額）"
                                                             IsChecked="{Binding FlagSettingsVM.SelectedItem.IsAmountTypeRate}"
                                                             GroupName="AmountTypeGroup" Margin="0,0,15,0"/>
                                                <RadioButton Content="固定金額（円）"
                                                             IsChecked="{Binding FlagSettingsVM.SelectedItem.IsAmountTypeFixed}"
                                                             GroupName="AmountTypeGroup"/>
                                            </StackPanel>

                                            <Label FontWeight="Bold">
                                                <Label.Style>
                                                    <Style TargetType="Label">
                                                        <Setter Property="Content" Value="固定金額（円）"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FlagSettingsVM.SelectedItem.IsRate}" Value="True">
                                                                <Setter Property="Content" Value="倍率"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Label.Style>
                                            </Label>
                                            <TextBox Text="{Binding FlagSettingsVM.SelectedItem.AmountValueText,
                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,4"/>
                                            <TextBlock Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="例: 5000（5000円固定）"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FlagSettingsVM.SelectedItem.IsRate}" Value="True">
                                                                <Setter Property="Text" Value="例: 0.5（基本料金の半額）"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- 適用対象料金 -->
                                            <Label Content="適用対象料金" FontWeight="Bold" Margin="0,10,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <RadioButton Content="基本料金"
                                                             IsChecked="{Binding FlagSettingsVM.SelectedItem.IsTargetBaseFee}"
                                                             GroupName="TargetFeeGroup" Margin="0,0,15,0"/>
                                                <RadioButton Content="走行距離料金"
                                                             IsChecked="{Binding FlagSettingsVM.SelectedItem.IsTargetMileageFee}"
                                                             GroupName="TargetFeeGroup" Margin="0,0,15,0"/>
                                                <RadioButton Content="両方"
                                                             IsChecked="{Binding FlagSettingsVM.SelectedItem.IsTargetBoth}"
                                                             GroupName="TargetFeeGroup"/>
                                            </StackPanel>
                                            <TextBlock Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="基本料金に倍率・金額を適用します"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FlagSettingsVM.SelectedItem.IsTargetMileageFee}" Value="True">
                                                                <Setter Property="Text" Value="走行距離料金に倍率・金額を適用します"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FlagSettingsVM.SelectedItem.IsTargetBoth}" Value="True">
                                                                <Setter Property="Text" Value="基本料金・走行距離料金の両方に適用します"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="バックアップ">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <GroupBox Header="自動バックアップ" Foreground="{StaticResource TextBrush}" Margin="0,5,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="起動時に自動作成するバックアップの保持数（最大50件）" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="保持件数：" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    <TextBox Width="60"
                                             Text="{Binding MaxAutoBackupFiles, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="6,0"/>
                                    <TextBlock Text="件" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Header="手動バックアップ" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="手動で作成するバックアップの保持数（最大100件）" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="保持件数：" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    <TextBox Width="60"
                                             Text="{Binding MaxManualBackupFiles, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="6,0"/>
                                    <TextBlock Text="件" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
