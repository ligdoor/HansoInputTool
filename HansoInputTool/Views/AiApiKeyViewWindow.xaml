<Window x:Class="HansoInputTool.Views.AiApiKeyViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI APIキー"
        Height="220" Width="620"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="🔑 APIキー（30秒間だけ表示）" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="1" Text="この画面を閉じると再びマスクされます。"
                   Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,10"/>
        <TextBox Grid.Row="2" Text="{Binding ApiKey}" IsReadOnly="True" Padding="8,7" FontSize="12"
                 Background="#172033" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource InputBorderBrush}"/>
        <TextBlock x:Name="CountdownText" Grid.Row="3" Text="残り30秒" Foreground="#64748b" FontSize="11" Margin="0,5,0,0"/>
        <Button Grid.Row="4" Content="閉じる" Click="CloseButton_Click" HorizontalAlignment="Right"
                Style="{StaticResource NormalButton}" Background="{StaticResource ButtonSecondaryBgBrush}" Padding="18,7"/>
    </Grid>
</Window>
