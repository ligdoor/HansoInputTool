<Window x:Class="HansoInputTool.Views.TransferConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="転記前の最終確認"
        Height="820"
        Width="1280"
        MinWidth="1050"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="{StaticResource BgBrush}">

    <Window.Resources>
        <!-- 車両カード -->
        <Style x:Key="VehicleTabStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Background="{StaticResource PanelBackgroundBrush}"
                                BorderBrush="{StaticResource InputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12,9"
                                MinWidth="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding TabHeader}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding WorkingDaysText}"
                                               FontSize="11"
                                               Foreground="{StaticResource SubTextBrush}"/>
                                    <TextBlock Text="  •  "
                                               FontSize="10"
                                               Foreground="{StaticResource SubTextBrush}"
                                               Margin="3,0"/>
                                    <TextBlock Text="{Binding IssueCountText}"
                                               FontSize="11"
                                               Foreground="{Binding StatusColor}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource ButtonSecondaryBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource ButtonSecondaryBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransferRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Background" Value="#26EF4444"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                    <Setter Property="Background" Value="#26F59E0B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="転記前の最終確認"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="内容を確認してから転記を実行してください。問題のある車両は下の一覧から確認できます。"
                           FontSize="12"
                           Foreground="{StaticResource SubTextBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="14,9">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="車両 " Foreground="{StaticResource SubTextBrush}"/>
                    <TextBlock Text="{Binding TotalVehicles}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="2,0,14,0"/>
                    <TextBlock Text="エラー " Foreground="{StaticResource SubTextBrush}"/>
                    <TextBlock Text="{Binding VehiclesWithErrors}" FontWeight="Bold" Foreground="{StaticResource RedBrush}" Margin="2,0,14,0"/>
                    <TextBlock Text="警告 " Foreground="{StaticResource SubTextBrush}"/>
                    <TextBlock Text="{Binding VehiclesWithWarnings}" FontWeight="Bold" Foreground="#F59E0B" Margin="2,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 転記先 + 全体金額 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="15,11"
                    Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="転記先" FontSize="12" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <TextBlock Text="{Binding Period, StringFormat={}期 {0}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,18,0"/>
                    <TextBlock Text="{Binding Month, StringFormat={}月 {0}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,18,0"/>
                    <TextBlock Text="{Binding RNumber, StringFormat={}R {0}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource GreenBrush}"
                    CornerRadius="7"
                    Padding="18,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="今回の推定売上" Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding TotalEstimatedRevenue, StringFormat=¥{0}}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 車両一覧 + 詳細 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：車両ナビゲーション -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="2,2,2,10">
                        <TextBlock Text="確認する車両" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="車両を選択すると右側に詳細が表示されます" FontSize="10" Foreground="{StaticResource SubTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListBox ItemsSource="{Binding VehicleTabs}"
                                 SelectedItem="{Binding SelectedVehicle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource VehicleTabStyle}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右：選択車両の詳細 -->
            <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 選択車両サマリー -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Text="確認中の車両" FontSize="10" Foreground="{StaticResource SubTextBrush}"/>
                        <TextBlock Text="{Binding SelectedVehicle.DisplayName}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Text="搬送回数" FontSize="10" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentVehicleSummary.TotalHanso, StringFormat={}{0}回}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Text="走行距離" FontSize="10" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentVehicleSummary.TotalKm, StringFormat={}{0:N0}km}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource SummaryCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="推定売上" FontSize="10" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentVehicleSummary.EstimatedRevenue, StringFormat=¥{0:N0}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- データ -->
                <Border Grid.Row="0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="8"
                        Margin="0,0,0,10">
                    <DataGrid ItemsSource="{Binding CurrentVehicleRows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              RowStyle="{StaticResource TransferRowStyle}"
                              GridLinesVisibility="Horizontal"
                              Background="{StaticResource PanelBackgroundBrush}"
                              RowHeight="30"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日" Binding="{Binding Day}" Width="45"/>
                            <DataGridTextColumn Header="搬送" Binding="{Binding HansoCount}" Width="55"/>
                            <DataGridTextColumn Header="有料km" Binding="{Binding YuryoKm}" Width="75"/>
                            <DataGridTextColumn Header="無料km" Binding="{Binding MuryoKm}" Width="75"/>
                            <DataGridTextColumn Header="行旅" Binding="{Binding IsKoryo}" Width="50"/>
                            <DataGridTextColumn Header="深夜" Binding="{Binding LateValue}" Width="70"/>
                            <DataGridTextColumn Header="基本料" Binding="{Binding BaseFee}" Width="85">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="走行料" Binding="{Binding MileageFee}" Width="85">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="深夜料" Binding="{Binding LateFee}" Width="85">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="合計" Binding="{Binding TotalFee}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- 問題一覧 -->
                <Border Grid.Row="1"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12"
                        MaxHeight="170">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="確認事項" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="　赤=エラー / 黄=警告" FontSize="11" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox Content="エラーのみ"
                                      IsChecked="{Binding ShowErrorsOnly}"
                                      DockPanel.Dock="Right"
                                      VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ValidationIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgBrush}"
                                                BorderBrush="{Binding Color}"
                                                BorderThickness="3,0,0,0"
                                                Padding="9,6"
                                                Margin="0,2"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding Command="{Binding DataContext.JumpToIssueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"
                                                              MouseAction="LeftClick"/>
                                            </Border.InputBindings>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{Binding Color}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </Grid>

        <!-- フッター -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="前の車両・次の車両で内容を順番に確認できます。"
                           FontSize="11"
                           Foreground="{StaticResource SubTextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="← 前の車両"
                    Command="{Binding PreviousVehicleCommand}"
                    Style="{StaticResource NormalButton}"
                    Background="{StaticResource ButtonSecondaryBgBrush}"
                    Padding="18,9"
                    Margin="0,0,8,0"/>
            <Button Grid.Column="2"
                    Content="次の車両 →"
                    Command="{Binding NextVehicleCommand}"
                    Style="{StaticResource NormalButton}"
                    Background="{StaticResource ButtonSecondaryBgBrush}"
                    Padding="18,9"
                    Margin="0,0,18,0"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Content="データを修正"
                        Command="{Binding EditDataCommand}"
                        Style="{StaticResource NormalButton}"
                        Background="{StaticResource ButtonSecondaryBgBrush}"
                        Padding="18,9"
                        Margin="0,0,8,0"/>
                <Button Content="中止"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource NormalButton}"
                        Background="{StaticResource RedBrush}"
                        Padding="20,9"
                        Margin="0,0,8,0"/>
                <Button Content="✓ 転記を実行"
                        Command="{Binding ConfirmTransferCommand}"
                        Style="{StaticResource NormalButton}"
                        Background="{StaticResource GreenBrush}"
                        Padding="28,10"
                        FontSize="14"
                        FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
