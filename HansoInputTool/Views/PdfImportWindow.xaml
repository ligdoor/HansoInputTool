<Window x:Class="HansoInputTool.Views.PdfImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HansoInputTool.Converters"
        Title="PDF日報読み込み"
        Height="640" Width="820"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter    x:Key="NullToVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- ヘッダーボタン -->
            <RowDefinition Height="Auto"/>   <!-- ステータス -->
            <RowDefinition Height="Auto"/>   <!-- プログレス -->
            <RowDefinition Height="*"/>      <!-- リスト -->
            <RowDefinition Height="Auto"/>   <!-- 一括登録 -->
        </Grid.RowDefinitions>

        <!-- ヘッダーボタン -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="📄 PDF日報読み込み" FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Command="{Binding SelectAndAnalyzePdfCommand}"
                    Style="{StaticResource NormalButton}"
                    Background="{StaticResource AccentBrush}" Padding="14,7" Margin="0,0,8,0">
                <TextBlock Text="📂 PDFを選択して解析"/>
            </Button>
            <Button Command="{Binding RegisterAllCommand}"
                    Style="{StaticResource NormalButton}"
                    Background="#16a34a" Padding="14,7">
                <TextBlock Text="✅ 全件登録"/>
            </Button>
        </StackPanel>

        <!-- ステータス -->
        <Border Grid.Row="1" Background="#0F172A" CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
        </Border>

        <!-- プログレスバー（解析中のみ表示） -->
        <ProgressBar Grid.Row="2" Height="4" Margin="0,0,0,8"
                     Minimum="0" Maximum="{Binding ProgressTotal}"
                     Value="{Binding ProgressCurrent}"
                     Foreground="{StaticResource AccentBrush}"
                     Background="#172033"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

        <!-- データリスト -->
        <Border Grid.Row="3" Background="#0b1220"
                BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <!-- 空の時のメッセージ -->
                <TextBlock Text="「PDFを選択して解析」ボタンでPDFを読み込んでください"
                           Foreground="{StaticResource SubTextBrush}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                <ListView ItemsSource="{Binding Items}"
                          Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource TextBrush}"
                          Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <ListView.View>
                        <GridView>
                            <!-- ページ・日付・車両 -->
                            <GridViewColumn Header="ページ / 日付 / 車両" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 日 -->
                            <GridViewColumn Header="日" Width="52">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Day, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#172033" Foreground="{StaticResource TextBrush}"
                                                 BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                                                 Width="42" Padding="3,2" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 有料km -->
                            <GridViewColumn Header="有料km" Width="72">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding YuryoKm, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#172033" Foreground="{StaticResource TextBrush}"
                                                 BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                                                 Width="62" Padding="3,2" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 無料km -->
                            <GridViewColumn Header="無料km" Width="72">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding MuryoKm, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#172033" Foreground="{StaticResource TextBrush}"
                                                 BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                                                 Width="62" Padding="3,2" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 深夜(分) -->
                            <GridViewColumn Header="深夜(分)" Width="72">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ShinyaMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#172033" Foreground="{StaticResource TextBrush}"
                                                 BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                                                 Width="62" Padding="3,2" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 状態 -->
                            <GridViewColumn Header="状態" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 操作ボタン -->
                            <GridViewColumn Header="" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="登録"
                                                    Command="{Binding DataContext.RegisterItemCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource NormalButton}"
                                                    Background="#16a34a"
                                                    Padding="10,4" Margin="0,0,4,0" FontSize="11"/>
                                            <Button Content="削除"
                                                    Command="{Binding DataContext.RemoveItemCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource NormalButton}"
                                                    Background="#7f1d1d"
                                                    Padding="10,4" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="Padding" Value="4,4"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1e3a5f"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#172033"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Border>

        <!-- 一括登録フッター -->
        <Border Grid.Row="4" Background="#0F172A" CornerRadius="4" Padding="12,8" Margin="0,10,0,0"
                Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource SubTextBrush}">
                    <Run Text="※ 各行の数値を日報と目視確認してから登録してください"/>
                </TextBlock>
                <Button Grid.Column="1"
                        Command="{Binding RegisterAllCommand}"
                        Style="{StaticResource NormalButton}"
                        Background="#16a34a" Padding="16,8">
                    <TextBlock Text="✅ 全件まとめて登録" FontSize="13"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
