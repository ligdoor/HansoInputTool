<Window x:Class="HansoInputTool.Views.PdfImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HansoInputTool.Converters"
        Title="PDF日報読み込み・確認"
        Height="700" Width="1120"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="📄 PDF日報読み込み・確認" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="AIの読み取り結果を日報と目視確認してから登録します。" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding SelectAndAnalyzePdfCommand}" Style="{StaticResource NormalButton}"
                    Background="{StaticResource AccentBrush}" Padding="18,9" VerticalAlignment="Center">
                <TextBlock Text="📂 PDFを選択して解析" FontSize="13"/>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="AIプロバイダー" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding ProviderName}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="10,0,24,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="モデル" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding ModelName}" Foreground="{StaticResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#172033" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                CornerRadius="7" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" FontSize="12"/>
                <ProgressBar Grid.Column="1" Width="180" Height="8" Margin="14,0,0,0" Minimum="0" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressCurrent}"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="4,2,4,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="読み取り結果" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" FontSize="14"/>
                    <TextBlock Grid.Column="1" Text="☑ 確認済みの行だけ登録可能" Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="確認" Width="58">
                                <GridViewColumn.CellTemplate><DataTemplate>
                                    <CheckBox IsChecked="{Binding IsConfirmed, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                </DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="対象" Width="155">
                                <GridViewColumn.CellTemplate><DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="AI読取車両：{Binding VehicleNumber}" Foreground="{StaticResource SubTextBrush}" FontSize="10"/>
                                    </StackPanel>
                                </DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="日" Width="70">
                                <GridViewColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Day, UpdateSourceTrigger=PropertyChanged}" Width="55" Padding="4,3" Background="#172033" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource InputBorderBrush}"/></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="有料km" Width="90">
                                <GridViewColumn.CellTemplate><DataTemplate><TextBox Text="{Binding YuryoKm, UpdateSourceTrigger=PropertyChanged}" Width="75" Padding="4,3" Background="#172033" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource InputBorderBrush}"/></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="無料km" Width="90">
                                <GridViewColumn.CellTemplate><DataTemplate><TextBox Text="{Binding MuryoKm, UpdateSourceTrigger=PropertyChanged}" Width="75" Padding="4,3" Background="#172033" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource InputBorderBrush}"/></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="深夜(分)" Width="90">
                                <GridViewColumn.CellTemplate><DataTemplate><TextBox Text="{Binding ShinyaMinutes, UpdateSourceTrigger=PropertyChanged}" Width="75" Padding="4,3" Background="#172033" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource InputBorderBrush}"/></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="状態" Width="190">
                                <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="11"/></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="操作" Width="105">
                                <GridViewColumn.CellTemplate><DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="PDF" Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Style="{StaticResource NormalButton}" Background="#334155" Padding="8,4" FontSize="11" Margin="0,0,4,0"/>
                                        <Button Content="登録" Command="{Binding DataContext.RegisterItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Style="{StaticResource NormalButton}" Background="#16a34a" Padding="8,4" FontSize="11" Margin="0,0,4,0"/>
                                        <Button Content="削除" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Style="{StaticResource NormalButton}" Background="#7f1d1d" Padding="8,4" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="Padding" Value="4,5"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#172033"/></Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="#0F172A" CornerRadius="6" Padding="12,9" Margin="0,10,0,0" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="⚠ AIの結果を必ず元の日報と照合してください。登録すると通常入力へ反映されます。" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" FontSize="11"/>
                <Button Grid.Column="1" Command="{Binding RegisterAllCommand}" Style="{StaticResource NormalButton}" Background="#16a34a" Padding="18,8">
                    <TextBlock Text="☑ 確認済みを一括登録" FontSize="13"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
