<Window x:Class="HansoInputTool.Views.AuditHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登録・修正履歴" Height="620" Width="1050"
        MinHeight="420" MinWidth="760" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid Margin="16" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="検索" Foreground="{StaticResource SubTextBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center"/>
        </DockPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="日時" Binding="{Binding EventAt}" Width="145"/>
                <DataGridTextColumn Header="利用者" Binding="{Binding UserName}" Width="100"/>
                <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="85"/>
                <DataGridTextColumn Header="種類" Binding="{Binding EntityType}" Width="75"/>
                <DataGridTextColumn Header="車両・シート" Binding="{Binding SheetName}" Width="190"/>
                <DataGridTextColumn Header="日" Binding="{Binding Day}" Width="45"/>
                <DataGridTextColumn Header="変更内容" Binding="{Binding ChangeSummary}" Width="*" MinWidth="270"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="{Binding ResultCount}" Margin="0,10,0,0" HorizontalAlignment="Right"/>
    </Grid>
</Window>
