<Window x:Class="HansoInputTool.Views.SessionSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HansoInputTool.Converters"
        Title="月データの切替"
        Height="600" Width="980"
        MinHeight="520" MinWidth="820"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SessionListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#172033"
                                BorderBrush="#2b3950"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,11">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1e3a5f"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3b82f6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource NormalButton}">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="月データの切替"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="保存・確定状態を確認して、使用する月のデータを切り替えます。"
                           FontSize="12"
                           Foreground="{StaticResource SubTextBrush}"
                           Margin="0,5,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#172033"
                    BorderBrush="#2b3950"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14,7">
                <TextBlock Text="{Binding CurrentSessionLabel}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
            </Border>
        </Grid>

        <!-- Guidance -->
        <Border Grid.Row="1"
                Background="#10243a"
                BorderBrush="#234a70"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,9"
                Margin="0,0,0,14">
            <TextBlock Text="月報ファイルを読み込むと自動で月データが作成されます。保存済みの月はクリアや転記後の自動クリアから保護され、確定済みの月は編集・削除から保護されます。"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{StaticResource SubTextBrush}"/>
        </Border>

        <!-- Main -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <!-- Session list -->
            <Border Grid.Column="0"
                    Background="#101827"
                    BorderBrush="#26354b"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="月データ一覧"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding SessionCountText}"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="{StaticResource SubTextBrush}"/>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Sessions}"
                             SelectedItem="{Binding SelectedSession}"
                             ItemContainerStyle="{StaticResource SessionListItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding RecordCount, StringFormat=実績件数：{0}件}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SubTextBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Border Background="#1e3a5f"
                                                CornerRadius="10"
                                                Padding="8,4"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="使用中"
                                                       FontSize="10"
                                                       Foreground="#93c5fd"
                                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"/>
                                        </Border>
                                        <Border Background="#164e63"
                                                CornerRadius="10"
                                                Padding="8,4"
                                                Margin="0,0,5,0">
                                            <TextBlock Text="保存済"
                                                       FontSize="10"
                                                       Foreground="#67e8f9"
                                                       Visibility="{Binding IsSaved, Converter={StaticResource BoolToVis}}"/>
                                        </Border>
                                        <Border Background="#14532d"
                                                CornerRadius="10"
                                                Padding="8,4">
                                            <TextBlock Text="確定済"
                                                       FontSize="10"
                                                       Foreground="#86efac"
                                                       Visibility="{Binding IsConfirmed, Converter={StaticResource BoolToVis}}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Details -->
            <Border Grid.Column="1"
                    Background="#101827"
                    BorderBrush="#26354b"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <Grid DataContext="{Binding SelectedSession}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="選択中の月"
                               FontSize="12"
                               Foreground="{StaticResource SubTextBrush}"/>
                    <TextBlock Grid.Row="1"
                               Text="{Binding Label, TargetNullValue=月データを選択してください}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,5,0,18"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#172033" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="実績件数" FontSize="10" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock Text="{Binding RecordCount, StringFormat={}{0} 件}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#172033" CornerRadius="8" Padding="12" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="保存状態" FontSize="10" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="未保存"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                    <Setter Property="Text" Value="保存済み"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#172033" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="確定状態" FontSize="10" Foreground="{StaticResource SubTextBrush}"/>
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="未確定"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConfirmed}" Value="True">
                                                    <Setter Property="Text" Value="確定済み"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,22,0,0">
                        <TextBlock Text="操作について"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="・切替：選択した月を現在の入力対象にします。&#x0a;・保存解除：保存による自動クリア保護を解除します。&#x0a;・確定解除：確定による編集・削除保護を解除します。&#x0a;・削除：選択した月のデータを削除します。"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   LineHeight="22"
                                   Foreground="{StaticResource SubTextBrush}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4"
                               Text="月データを選択すると操作ボタンが有効になります。"
                               FontSize="10"
                               Foreground="#64748b"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock VerticalAlignment="Center"
                       Text="月報から作成されたデータはここで管理できます。"
                       FontSize="10"
                       Foreground="#64748b"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存解除"
                        Command="{Binding UnsaveCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#1e40af"
                        Foreground="White"/>
                <Button Content="確定解除"
                        Command="{Binding UnconfirmCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#92400e"
                        Foreground="White"/>
                <Button Content="確定"
                        Command="{Binding ConfirmCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#065f46"
                        Foreground="White"/>
                <Button Content="削除"
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#7f1d1d"
                        Foreground="White"/>
                <Button Content="キャンセル"
                        Click="CancelButton_Click"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="{StaticResource ButtonSecondaryBgBrush}"/>
                <Button Content="月を切り替える"
                        Command="{Binding SwitchCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="18,9"
                        Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
