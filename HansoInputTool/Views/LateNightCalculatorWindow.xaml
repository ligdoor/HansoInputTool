<Window x:Class="HansoInputTool.Views.LateNightCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:HansoInputTool.Converters"
        xmlns:behaviors="clr-namespace:HansoInputTool.Behaviors"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="深夜時間の計算" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="ApplyButtonStyle" TargetType="Button" BasedOn="{StaticResource NormalButton}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="{StaticResource GreenBrush}"/>
        </Style>

        <Style x:Key="TimePartTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="MaxLength" Value="2"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <StackPanel Margin="18,16,18,14">
            <TextBlock Text="深夜時間の計算" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="会社出発時刻と故人宅出発時刻から、深夜時間帯（22:00〜翌5:00）に該当する時間を計算します。"
                       Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,16"/>

            <Border Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="会社出発時間" FontSize="13" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="CompanyHourTextBox" Style="{StaticResource TimePartTextBox}"
                                 Text="{Binding CompanyHour, UpdateSourceTrigger=PropertyChanged}" ToolTip="時（0〜23）">
                            <i:Interaction.Behaviors>
                                <behaviors:NumericInputBehavior/>
                            </i:Interaction.Behaviors>
                        </TextBox>
                        <TextBlock Text="時" VerticalAlignment="Center" Margin="4,0"/>
                        <TextBox x:Name="CompanyMinuteTextBox" Style="{StaticResource TimePartTextBox}"
                                 Text="{Binding CompanyMinute, UpdateSourceTrigger=PropertyChanged}" ToolTip="分（0〜59）">
                            <i:Interaction.Behaviors>
                                <behaviors:NumericInputBehavior/>
                            </i:Interaction.Behaviors>
                        </TextBox>
                        <TextBlock Text="分" VerticalAlignment="Center" Margin="4,0"/>
                    </StackPanel>

                    <TextBlock Text="故人宅出発時間" FontSize="13" Margin="0,14,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="HomeHourTextBox" Style="{StaticResource TimePartTextBox}"
                                 Text="{Binding HomeHour, UpdateSourceTrigger=PropertyChanged}" ToolTip="時（0〜23）">
                            <i:Interaction.Behaviors>
                                <behaviors:NumericInputBehavior/>
                            </i:Interaction.Behaviors>
                        </TextBox>
                        <TextBlock Text="時" VerticalAlignment="Center" Margin="4,0"/>
                        <TextBox x:Name="HomeMinuteTextBox" Style="{StaticResource TimePartTextBox}"
                                 Text="{Binding HomeMinute, UpdateSourceTrigger=PropertyChanged}" ToolTip="分（0〜59）">
                            <i:Interaction.Behaviors>
                                <behaviors:NumericInputBehavior/>
                            </i:Interaction.Behaviors>
                        </TextBox>
                        <TextBlock Text="分" VerticalAlignment="Center" Margin="4,0"/>
                    </StackPanel>
                    <TextBlock Text="※ 故人宅出発が会社出発より時刻的に早い場合は、翌日として計算します。"
                               Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextStyle}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                       Margin="2,8,0,0"/>

            <Button Content="計算する" Command="{Binding CalculateCommand}"
                    Style="{StaticResource NormalButton}" Background="{StaticResource ButtonSecondaryBgBrush}"
                    Height="38" Margin="0,12,0,0"/>

            <Border Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"
                    BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding ResultSummaryText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ResultFeeText}" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ResultFeeText, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding TargetLabel, StringFormat='この値を「{0}」欄に反映します。'}"
                               Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="キャンセル" Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource NormalButton}" Height="42" FontSize="15"/>
                <Button Grid.Column="2" Content="反映する" Command="{Binding ApplyCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource ApplyButtonStyle}"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
